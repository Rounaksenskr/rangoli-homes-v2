datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id               String          @id @default(uuid())
  name             String
  phone            String
  email            String
  service          String
  message          String?
  city             String?
  propertyType     String?
  budgetBand       String?
  preferredContact String?
  source           String          @default("enquiry_modal")
  createdAt        DateTime        @default(now())
  consultations    Consultation[]
}

model Consultation {
  id            String   @id @default(uuid())
  bookingRef    String   @unique
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id])
  service       String
  startsAt      DateTime
  endsAt        DateTime
  slotKey       String?  @unique
  status        String   @default("CONFIRMED")
  googleEventId String?
  notes         String?
  createdAt     DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String
  service   String?
  message   String
  createdAt DateTime @default(now())
}